# Copie para .env (docker compose carrega .env automaticamente) e ajuste se
# quiser usar a OpenAI de verdade em vez do Ollama local.

# Ollama local (padrao deste projeto, sem custo):
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://host.docker.internal:11434/v1
OPENAI_MODEL=llama3.1

# Para usar a OpenAI de verdade em vez do Ollama, comente as 3 linhas acima e
# descomente estas (e use uma chave real):
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-5.1-mini
